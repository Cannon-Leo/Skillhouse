{
  "extends": ["next/core-web-vitals", "next/typescript", "plugin:boundaries/recommended"],
  "plugins": ["boundaries"],
  "settings": {
    "boundaries/elements": [
      {
        "type": "app",
        "pattern": "src/app/*"
      },
      {
        "type": "features",
        "pattern": "src/features/*"
      },
      {
        "type": "components",
        "pattern": "src/components/*"
      },
      {
        "type": "lib",
        "pattern": "src/lib/*"
      }
    ]
  },
  "rules": {
    "boundaries/element-types": [
      2,
      {
        "default": "disallow",
        "rules": [
          {
            "from": ["app"],
            "allow": ["features", "components", "lib"]
          },
          {
            "from": ["features"],
            "allow": ["components", "lib"]
          },
          {
            "from": ["components"],
            "allow": ["components", "lib"]
          },
          {
            "from": ["lib"],
            "allow": ["lib"]
          }
        ]
      }
    ]
  }
}
